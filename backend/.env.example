# Copy this file to .env and fill in the real values. Never commit .env.
HELPDESK_BASE_URL=https://nakywgkztvzkihdjnwbc.supabase.co/functions/v1/helpdesk
HELPDESK_KEY=nrd_round_xxxxxxxx
CANDIDATE_EMAIL=you@example.com
CANDIDATE_NAME=Your Full Name

# LLM: decides + writes drafts/notes + verifies. Leave LLM_PROVIDER empty to run without the AI stages.
# Switch provider with one line; each provider reads its own key. List models: python -m app.cli models
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
GEMINI_API_KEY=
# Local model instead (free, runs on your GPU): LLM_PROVIDER=ollama, LLM_MODEL=<name from `ollama list`>
OLLAMA_BASE_URL=http://localhost:11434
LLM_NUM_CTX=8192
# Cap on the model's answer length (stops a runaway answer from hanging a ticket).
LLM_MAX_OUTPUT_TOKENS=4096
# Optional, Gemini only: 0 disables "thinking" on Flash models (cheaper, faster).
LLM_THINKING_BUDGET=

# Classifier: "llm" = the LLM decides and writes in one call (default)
#             "jev" = Jev (TypeSafe AI) decides with probabilities, the LLM only writes. Needs: pip install -r requirements-jev.txt
CLASSIFIER=llm
TYPESAFE_API_KEY=
JEV_MODEL=

# Optional: price of the writing LLM in USD per 1M tokens, for the cost-per-100-tickets figure.
# Leave empty to use the built-in list prices in app/core/pricing.py.
LLM_PRICE_IN_PER_M=
LLM_PRICE_OUT_PER_M=

# Tuning
REPLY_CONFIDENCE_THRESHOLD=0.70
NEEDS_REVIEW_THRESHOLD=0.70
MAX_POST_ATTEMPTS=3
